# Open ISP stack (experimental): open-tx-isp kernel driver plus the
# OpenIMP userspace ABI.  prudynt is built with USE_OPENIMP=1, which
# compiles out the IMP AENC/ADEC and fisheye entry points OpenIMP's
# T31 build does not export.
BR2_PACKAGE_THINGINO_ISP_OPEN=y
BR2_PACKAGE_THINGINO_ISP_OPEN_ABI_OPENIMP=y
